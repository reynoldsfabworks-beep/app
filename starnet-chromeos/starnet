#!/usr/bin/env bash
# `starnet` — run StarNet inside the ChromeOS Linux environment and open it in Chrome.
#
# ChromeOS forwards localhost ports from the Linux container to the browser, so the
# sidecar's loopback-only server at 127.0.0.1:8787 is reachable from Chrome as
# http://localhost:8787 without binding to any external interface.
set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONF_DIR="$CONFIG_HOME/starnet-chromeos"
STATE_DIR="$STATE_HOME/starnet-chromeos"
LOG_FILE="$STATE_DIR/sidecar.log"
PID_FILE="$STATE_DIR/sidecar.pid"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNIT="starnet.service"

PORT="${STARNET_PORT:-8787}"
URL="http://localhost:$PORT"

die() { echo "starnet: $*" >&2; exit 1; }

src_dir() {
  local src
  src="$(cat "$CONF_DIR/src-dir" 2>/dev/null || true)"
  [ -n "$src" ] && [ -f "$src/sidecar/index.js" ] || die "StarNet isn't installed — run install.sh first."
  printf '%s' "$src"
}

responding() { curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/" 2>/dev/null; }

service_enabled() {
  command -v systemctl >/dev/null && systemctl --user is-enabled -q "$UNIT" 2>/dev/null
}

# Runs the sidecar in the foreground with the environment the desktop shell would provide.
cmd_run() {
  local src
  src="$(src_dir)"
  export STARNET_PORT="$PORT"
  export STARNET_APP_VERSION
  STARNET_APP_VERSION="$(node -p "require('$src/package.json').version" 2>/dev/null || echo unknown)"
  if [ -s "$CONF_DIR/connector.key" ]; then
    STARNET_CONNECTOR_ENCRYPTION_KEY="$(cat "$CONF_DIR/connector.key")"
    export STARNET_CONNECTOR_ENCRYPTION_KEY
  fi
  cd "$src"
  exec node sidecar/index.js
}

cmd_start() {
  if responding; then echo "StarNet is already running at $URL"; return 0; fi
  mkdir -p "$STATE_DIR"
  if service_enabled; then
    systemctl --user start "$UNIT"
  else
    nohup "$0" run >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  fi
  printf 'Starting StarNet'
  for _ in $(seq 1 120); do
    if responding; then printf '\nStarNet is running at %s\n' "$URL"; return 0; fi
    printf '.'
    sleep 0.5
  done
  printf '\n'
  die "the sidecar did not come up within 60s — see: starnet logs"
}

cmd_stop() {
  if service_enabled && systemctl --user is-active -q "$UNIT"; then
    systemctl --user stop "$UNIT"
  fi
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
      for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    fi
    rm -f "$PID_FILE"
  fi
  if responding; then die "something is still serving on port $PORT (started outside this launcher?)"; fi
  echo "StarNet stopped."
}

cmd_open() {
  cmd_start
  # In Crostini, xdg-open hands URLs to garcon, which opens them in the ChromeOS browser.
  if command -v garcon-url-handler >/dev/null; then
    garcon-url-handler "$URL"
  elif command -v xdg-open >/dev/null; then
    xdg-open "$URL" >/dev/null 2>&1 &
  else
    echo "Open $URL in Chrome."
  fi
}

cmd_status() {
  if responding; then echo "running  $URL"; else echo "stopped"; fi
  if service_enabled; then echo "autostart: on"; else echo "autostart: off"; fi
  echo "source:   $(src_dir)"
}

cmd_logs() {
  if service_enabled; then
    journalctl --user -u "$UNIT" -n 200 --no-pager
  elif [ -f "$LOG_FILE" ]; then
    tail -n 200 "$LOG_FILE"
  else
    echo "no logs yet"
  fi
}

# Keeps StarNet running whenever the Linux container is up — needed for Night Shift and schedules,
# which only run while the sidecar is alive.
cmd_autostart() {
  command -v systemctl >/dev/null || die "systemd isn't available in this container"
  case "${1:-}" in
    on)
      mkdir -p "$UNIT_DIR"
      cat > "$UNIT_DIR/$UNIT" <<EOF
[Unit]
Description=StarNet agent harness (sidecar)

[Service]
ExecStart=$(readlink -f "$0") run
Restart=on-failure
RestartSec=5
Environment=STARNET_PORT=$PORT

[Install]
WantedBy=default.target
EOF
      # hand over from a launcher-started process, if any
      if [ -f "$PID_FILE" ]; then cmd_stop >/dev/null || true; fi
      systemctl --user daemon-reload
      systemctl --user enable --now "$UNIT"
      echo "autostart on — StarNet now starts with the Linux environment."
      ;;
    off)
      systemctl --user disable --now "$UNIT" 2>/dev/null || true
      rm -f "$UNIT_DIR/$UNIT"
      systemctl --user daemon-reload
      echo "autostart off."
      ;;
    *) die "usage: starnet autostart on|off" ;;
  esac
}

cmd_update() {
  local src
  src="$(src_dir)"
  [ -d "$src/.git" ] || die "$src is not a git checkout"
  local ref="${1:-HEAD}"
  local was_running=0
  responding && was_running=1
  [ "$was_running" = 1 ] && cmd_stop
  git -C "$src" fetch -q --depth 1 origin "$ref"
  git -C "$src" checkout -q --force FETCH_HEAD
  (cd "$src" && npm ci --omit=dev --no-audit --no-fund) \
    || (cd "$src" && npm ci --omit=dev --no-audit --no-fund --ignore-scripts)
  echo "Updated to $(git -C "$src" rev-parse --short HEAD) (${ref})."
  [ "$was_running" = 1 ] && cmd_start
  return 0
}

usage() {
  cat <<EOF
usage: starnet <command>

  open             start StarNet if needed and open it in Chrome (default)
  start | stop | restart
  status           show whether the sidecar is running
  logs             show recent sidecar output
  autostart on|off keep StarNet running whenever Linux is running (for Night Shift / schedules)
  update [ref]     pull the latest StarNet (or a given branch/tag/commit) and reinstall deps
  run              run the sidecar in the foreground
EOF
}

case "${1:-open}" in
  open)      cmd_open ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; cmd_start ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  autostart) shift; cmd_autostart "$@" ;;
  update)    shift; cmd_update "$@" ;;
  run)       cmd_run ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac

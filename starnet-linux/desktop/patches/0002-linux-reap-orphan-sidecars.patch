+/// The executable image of `pid`, as the kernel reports it through /proc. None when the process
+/// is gone, is a zombie, or belongs to another user (the link is unreadable) — never a guess.
+#[cfg(all(not(windows), not(target_os = "macos")))]
+fn linux_process_image_path(pid: i32) -> Option<PathBuf> {
+    std::fs::read_link(format!("/proc/{pid}/exe")).ok()
+}

+// Linux ships Node as an app resource (src-tauri/tauri.linux.conf.json), not an externalBin, so the
+// packaged binary never lands in /usr/bin. Tauri resources have no per-target naming, so every Linux
+// target also publishes an arch-neutral copy that the Linux config maps to <resources>/node.
+function publishLinuxAlias(r, out, outDir) {
+  if (!r.target.startsWith('linux-')) return;
+  const alias = join(outDir, 'node-linux');
+  copyFileSync(out, alias);
+  try { chmodSync(alias, 0o755); } catch {}
+  console.log(`[prepare-node] linux resource alias -> ${alias}`);
+}

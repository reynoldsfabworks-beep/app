#!/usr/bin/env bash
# `starnet` — run StarNet's sidecar on Linux (or ChromeOS's Linux environment) and open the station.
#
# The sidecar serves the whole UI on 127.0.0.1 only. On ChromeOS, localhost is forwarded from the
# Linux container to Chrome, so http://localhost:8787 works there without exposing any interface.
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONF_DIR="$CONFIG_HOME/starnet-linux"
STATE_DIR="$STATE_HOME/starnet-linux"
LOG_FILE="$STATE_DIR/sidecar.log"
PID_FILE="$STATE_DIR/sidecar.pid"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNIT="starnet.service"
XDG_AUTOSTART="$CONFIG_HOME/autostart/starnet.desktop"

PORT="${STARNET_PORT:-8787}"
URL="http://localhost:$PORT"
SELF="$(readlink -f "$0")"

# A private Node.js download (see install.sh) takes precedence over the system one.
if [ -s "$CONF_DIR/node-bin" ]; then PATH="$(cat "$CONF_DIR/node-bin"):$PATH"; export PATH; fi

die() { echo "starnet: $*" >&2; exit 1; }

src_dir() {
  local src
  src="$(cat "$CONF_DIR/src-dir" 2>/dev/null || true)"
  [ -n "$src" ] && [ -f "$src/sidecar/index.js" ] || die "StarNet isn't installed — run install.sh first."
  printf '%s' "$src"
}

responding() { curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/" 2>/dev/null; }

has_systemd_user() { command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; }
service_enabled() { has_systemd_user && systemctl --user is-enabled -q "$UNIT" 2>/dev/null; }

# Prints the connector-vault key, or nothing when this install has none. Fails (rather than
# starting keyless) when the key lives in a keyring that is locked or unreachable.
connector_key() {
  case "$(cat "$CONF_DIR/key-store" 2>/dev/null || echo file)" in
    keyring)
      local key
      key="$(timeout 60 secret-tool lookup service starnet-linux account connector-key 2>/dev/null || true)"
      [ -n "$key" ] || die "can't read StarNet's key from your keyring (locked, or no keyring service running). Unlock it and try again."
      printf '%s' "$key" ;;
    *)
      [ -s "$CONF_DIR/connector.key" ] && cat "$CONF_DIR/connector.key" ;;
  esac
  return 0
}

# Runs the sidecar in the foreground with the environment the desktop shell would provide.
cmd_run() {
  local src key
  src="$(src_dir)"
  key="$(connector_key)" || exit 1
  export STARNET_PORT="$PORT"
  export STARNET_APP_VERSION
  STARNET_APP_VERSION="$(node -p "require('$src/package.json').version" 2>/dev/null || echo unknown)"
  if [ -n "$key" ]; then export STARNET_CONNECTOR_ENCRYPTION_KEY="$key"; fi
  cd "$src"
  exec node sidecar/index.js
}

cmd_start() {
  if responding; then echo "StarNet is already running at $URL"; return 0; fi
  mkdir -p "$STATE_DIR"
  if service_enabled; then
    systemctl --user start "$UNIT"
  else
    connector_key >/dev/null || exit 1   # surface a locked keyring here, not only in the log
    nohup "$SELF" run >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  fi
  printf 'Starting StarNet'
  for _ in $(seq 1 120); do
    if responding; then printf '\nStarNet is running at %s\n' "$URL"; return 0; fi
    printf '.'
    sleep 0.5
  done
  printf '\n'
  die "the sidecar did not come up within 60s — see: starnet logs"
}

cmd_stop() {
  if service_enabled && systemctl --user is-active -q "$UNIT"; then
    systemctl --user stop "$UNIT"
  fi
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
      for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    fi
    rm -f "$PID_FILE"
  fi
  if responding; then die "something is still serving on port $PORT (started outside this launcher?)"; fi
  echo "StarNet stopped."
}

# Opens the station: ChromeOS hands the URL to Chrome; on desktop Linux a Chromium-family browser
# gives StarNet its own app window; anything else gets the default browser.
cmd_open() {
  cmd_start
  if [ "${STARNET_BROWSER:-app}" = none ]; then echo "Open $URL in your browser."; return; fi
  if command -v garcon-url-handler >/dev/null; then
    garcon-url-handler "$URL"
    return
  fi
  if [ "${STARNET_BROWSER:-app}" = app ]; then
    local b
    for b in google-chrome google-chrome-stable chromium chromium-browser brave-browser brave microsoft-edge microsoft-edge-stable vivaldi; do
      if command -v "$b" >/dev/null; then
        nohup "$b" --app="$URL" >/dev/null 2>&1 &
        return
      fi
    done
  fi
  if command -v xdg-open >/dev/null; then
    nohup xdg-open "$URL" >/dev/null 2>&1 &
  else
    echo "Open $URL in your browser."
  fi
}

cmd_status() {
  if responding; then echo "running    $URL"; else echo "stopped"; fi
  if service_enabled; then echo "autostart: on (systemd)"
  elif [ -f "$XDG_AUTOSTART" ]; then echo "autostart: on (at login)"
  else echo "autostart: off"; fi
  echo "keys:      $(cat "$CONF_DIR/key-store" 2>/dev/null || echo file)"
  echo "node:      $(command -v node) $(node -v 2>/dev/null || echo missing)"
  echo "source:    $(src_dir)"
}

cmd_logs() {
  if service_enabled; then
    journalctl --user -u "$UNIT" -n 200 --no-pager
  elif [ -f "$LOG_FILE" ]; then
    tail -n 200 "$LOG_FILE"
  else
    echo "no logs yet"
  fi
}

# Keeps StarNet running so Night Shift and schedules keep working. With systemd (most distros,
# ChromeOS) it starts with your user session and restarts on failure; without it, at desktop login.
cmd_autostart() {
  case "${1:-}" in
    on)
      if has_systemd_user; then
        mkdir -p "$UNIT_DIR"
        cat > "$UNIT_DIR/$UNIT" <<EOF
[Unit]
Description=StarNet agent harness (sidecar)

[Service]
ExecStart=$SELF run
Restart=on-failure
RestartSec=5
Environment=STARNET_PORT=$PORT

[Install]
WantedBy=default.target
EOF
        # hand over from a launcher-started process, if any
        if [ -f "$PID_FILE" ]; then cmd_stop >/dev/null || true; fi
        systemctl --user daemon-reload
        systemctl --user enable --now "$UNIT"
        echo "autostart on — StarNet now starts with your session and restarts if it crashes."
      else
        mkdir -p "$(dirname "$XDG_AUTOSTART")"
        cat > "$XDG_AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=StarNet (background)
Exec=env STARNET_PORT=$PORT $SELF start
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
        echo "autostart on — StarNet starts when you log in to your desktop (no systemd user session found)."
      fi
      ;;
    off)
      if has_systemd_user; then
        systemctl --user disable --now "$UNIT" 2>/dev/null || true
        rm -f "$UNIT_DIR/$UNIT"
        systemctl --user daemon-reload
      fi
      rm -f "$XDG_AUTOSTART"
      echo "autostart off."
      ;;
    *) die "usage: starnet autostart on|off" ;;
  esac
}

# Re-runs the installer from the package it was installed from: same slim download, dependency
# install and cleanup, key and settings kept. With no ref it (re)installs the pinned, tested StarNet
# commit; `starnet update main` (or any branch/tag/commit) moves to that instead.
cmd_update() {
  local pkg was_running=0
  pkg="$(cat "$CONF_DIR/pkg-dir" 2>/dev/null || true)"
  [ -f "$pkg/install.sh" ] || die "can't find the installer this was set up from — re-run get.sh or install.sh"
  responding && was_running=1
  [ "$was_running" = 1 ] && cmd_stop
  if [ -d "$pkg/../.git" ] && [ -f "$pkg/get.sh" ]; then
    # refresh the package itself, then run its installer
    env STARNET_PKG_DIR="$(cd "$pkg/.." && pwd)" ${1:+STARNET_REF="$1"} bash "$pkg/get.sh" --no-system-deps
  else
    env ${1:+STARNET_REF="$1"} bash "$pkg/install.sh" --no-system-deps
  fi
  [ "$was_running" = 1 ] && cmd_start
  return 0
}

usage() {
  cat <<EOF
usage: starnet <command>

  open             start StarNet if needed and open the station (default)
  start | stop | restart
  status           show whether the sidecar is running, and how it's set up
  logs             show recent sidecar output
  autostart on|off keep StarNet running in the background (for Night Shift / schedules)
  update [ref]     update this package and reinstall StarNet (pinned commit, or the given ref)
  run              run the sidecar in the foreground

  STARNET_PORT=<n>        use another port (default 8787)
  STARNET_BROWSER=default open in your default browser instead of an app window
  STARNET_BROWSER=none    just start it and print the address
EOF
}

case "${1:-open}" in
  open)      cmd_open ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; cmd_start ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  autostart) shift; cmd_autostart "$@" ;;
  update)    shift; cmd_update "$@" ;;
  run)       cmd_run ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
